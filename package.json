{
	"name": "llm-bridge",
	"displayName": "%displayName%",
	"description": "%description%",
	"version": "0.3.6",
	"publisher": "local",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/MrWolfox-ctrlcv/LLM-Bridge-for-Copilot-Chat.git"
	},
	"engines": {
		"vscode": "^1.116.0"
	},
	"categories": [
		"AI",
		"Chat"
	],
	"keywords": [
		"copilot",
		"llm-bridge",
		"local",
		"llama.cpp",
		"ollama",
		"openai-compatible",
		"deepseek",
		"mimo"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./out/extension.js",
	"icon": "icon.png",
	"contributes": {
		"languageModelChatProviders": [
			{
				"vendor": "llm-bridge",
				"displayName": "LLM Bridge"
			}
		],
		"commands": [
			{
				"command": "llm-bridge.refreshModels",
				"title": "%command.llm-bridge.refreshModels.title%"
			},
			{
				"command": "llm-bridge.openSettings",
				"title": "%command.llm-bridge.openSettings.title%"
			},
			{
				"command": "llm-bridge.checkBalance",
				"title": "%command.llm-bridge.checkBalance.title%"
			},
			{
				"command": "llm-bridge.setVisionModel",
				"title": "%command.llm-bridge.setVisionModel.title%"
			},
			{
				"command": "llm-bridge.addModel",
				"title": "%command.llm-bridge.addModel.title%"
			},
			{
				"command": "llm-bridge.manageModels",
				"title": "%command.llm-bridge.manageModels.title%"
			},
			{
				"command": "llm-bridge.testConnection",
				"title": "%command.llm-bridge.testConnection.title%"
			}
		],
		"configuration": {
			"title": "LLM Bridge",
			"properties": {
				"llm-bridge.endpoints": {
					"type": "array",
					"default": [],
					"markdownDescription": "OpenAI 兼容端点列表（支持多个，同一供应商勾选的多个模型共享一个 Key）。\n\n**推荐使用命令添加，无需手填此数组**：[LLM Bridge: 添加模型（预设）](command:llm-bridge.addModel) · [LLM Bridge: 管理模型](command:llm-bridge.manageModels)\n\n每项字段：`id`、`name`、`baseUrl`、`model`、`contextWindow`（0 = 128K）、`toolCalling`、`imageInput`、`thinking`、`sendThinkingParam`、`group`（共享 Key 的组 id）。",
					"items": {
						"type": "object",
						"default": {},
						"properties": {
							"id": { "type": "string", "default": "" },
							"name": { "type": "string", "default": "" },
							"baseUrl": { "type": "string", "default": "" },
							"apiKey": { "type": "string", "default": "" },
							"model": { "type": "string", "default": "" },
							"contextWindow": { "type": "number", "default": 0 },
							"toolCalling": { "type": "boolean", "default": true },
							"imageInput": { "type": "boolean", "default": false },
							"thinking": { "type": "boolean", "default": false },
							"sendThinkingParam": { "type": "boolean", "default": false },
							"group": { "type": "string", "default": "" },
							"cost": {
								"type": "object",
								"default": {},
								"description": "价格信息（¥/1M tokens）：input=输入（缓存未命中）、cache=缓存命中、output=输出、category=价格档位。仅预设提供，可选。",
								"properties": {
									"input": { "type": "string", "default": "" },
									"output": { "type": "string", "default": "" },
									"cache": { "type": "string", "default": "" },
									"category": { "type": "string", "default": "" }
								}
							}
						}
					}
				},
				"llm-bridge.contextWindow": {
					"type": "number",
					"default": 0,
					"description": "全局上下文窗口（tokens），覆盖所有模型；0 = 各端点默认 128K。超出时自动截断较早对话。"
				},
				"llm-bridge.visionModel": {
					"type": "string",
					"default": "",
					"markdownDescription": "视觉代理模型（vendor/id），留空自动选择第一个可用视觉模型（仅纯文本模型看图用；多模态模型原生收图不受影响）。\n\n[配置视觉代理模型](command:llm-bridge.setVisionModel)"
				},
				"llm-bridge.visionPrompt": {
					"type": "string",
					"editPresentation": "multilineText",
					"default": "Describe all image attachments in this message.\n\nIf there is one image, describe it directly.\nIf there are multiple images:\n1. Describe each image separately, preserving their order.\n2. Then provide a combined description explaining the overall context and relationships across the images.\n\nReturn one concise factual description suitable for inserting into a text-only chat prompt. Include visible text, objects, UI elements, people, and relevant context. Do not invent details.",
					"markdownDescription": "发送给视觉代理模型看图用的提示词"
				}
			}
		}
	},
	"scripts": {
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"vscode:prepublish": "npm run compile",
		"package": "vsce package",
		"package:release": "node scripts/package-release.mjs",
		"test": "vitest run"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"@types/vscode": "^1.116.0",
		"@vscode/vsce": "^3.9.1",
		"typescript": "^5.7.2",
		"vitest": "^4.1.10"
	}
}
